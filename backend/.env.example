# Gemini API — use GEMINI_API_KEYS (comma-separated) to enable automatic key rotation
# when one key hits its free-tier quota. GEMINI_API_KEY is the single-key fallback.
GEMINI_API_KEYS=key1,key2,key3
# GEMINI_API_KEY=your_gemini_api_key_here   ← use this if you only have one key

# Tavily Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Composio for X/Twitter
COMPOSIO_API_KEY=your_composio_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# GCP Cloud Run: GCS bucket for article persistence (required when deployed)
# Create bucket: gsutil mb gs://YOUR_PROJECT_ID-n2a-articles
# GCS_BUCKET=your-project-id-n2a-articles

# Composio entity ID for Reddit (from Composio dashboard, connect Reddit for this entity)
REDDIT_USER_ID=pg-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
